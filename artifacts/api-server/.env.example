# ==============================================================================
# CONON-NOW Backend API Server Environment Variables (Render / Express)
# ==============================================================================

# Server Port (Render injects PORT automatically; defaults to 5000)
PORT=5000

# Frontend URL for CORS (e.g. https://conon.vercel.app in production)
FRONTEND_URL=https://conon.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://conon.vercel.app

# MongoDB Connection String (MongoDB Atlas or local replica set)
MONGO_URI=mongodb+srv://<username>:<password>@conon.vcf5hgb.mongodb.net/conon?retryWrites=true&w=majority
MONGODB_DATABASE=conon

# JWT Secret for Auth & Session Tokens (min 32 characters)
JWT_SECRET=al-ae8Wb5zc6v4XIt6G8PHysQpgGjoAuiZH_RICTG6nrb7

# Razorpay Payment Gateway Credentials (Server-side)
RAZORPAY_KEY_ID=rzp_test_U2WeWQ1QNhcFm3
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Fast2SMS API Key for OTP SMS dispatch
FAST2SMS_API_KEY=your_fast2sms_api_key

# Firebase Server Web API Key for ID token verification
FIREBASE_WEB_API_KEY=

# Google Maps API Key for routing & distance calculation
GOOGLE_MAPS_API_KEY=

# Admin Master Credentials
ADMIN_EMAIL=admin@conon.in
ADMIN_PASSWORD=admin123
