# ==============================================================================
# CONON-NOW Root Configuration & Deployment Reference (.env.example)
# ==============================================================================

# Backend Server & CORS Configuration
PORT=5000
FRONTEND_URL=https://conon.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://conon.vercel.app

# ==============================================================================
# Hybrid Database Configuration
# 1. PostgreSQL: Relational Source of Truth (users, lucknow_hubs, hub_inventory, orders, order_items, payout_ledger)
# 2. MongoDB: Flexible Catalog Specs, SiteKits, LeadInbox & AuditAndDispatchLog
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conon_now
MONGODB_URI=mongodb+srv://<username>:<password>@conon.vcf5hgb.mongodb.net/conon?retryWrites=true&w=majority
MONGODB_DATABASE=conon

# Authentication Secrets
JWT_SECRET=your_jwt_secret_minimum_32_characters

# Razorpay Payment Gateway (Live / Test)
RAZORPAY_KEY_ID=rzp_test_U2WeWQ1QNhcFm3
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
VITE_RAZORPAY_KEY_ID=rzp_test_U2WeWQ1QNhcFm3

# SMS & OTP Providers
FAST2SMS_API_KEY=your_fast2sms_api_key

# Frontend API Origin (Vercel -> Render)
VITE_API_URL=http://localhost:5000

# Firebase Client & Server Auth
FIREBASE_WEB_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps API
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Admin Panel
ADMIN_EMAIL=admin@conon.in
ADMIN_PASSWORD=admin123
