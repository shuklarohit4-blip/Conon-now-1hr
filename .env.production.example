# ==============================================================================
# CONON-NOW Production Deployment Environment Reference
# Copy values into Railway / Render (Backend) & Netlify / Vercel (Frontend).
# NEVER commit real `.env` or secret values into Git.
# ==============================================================================

# --- Backend Runtime & Database ---
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/railway
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/conon?retryWrites=true&w=majority
MONGODB_DATABASE=conon

# --- Security & Authentication ---
JWT_SECRET=<generate-64-char-random-hex-secret>
ADMIN_EMAIL=founder@cononinfrabuilt.com
# Preferred: scrypt:<saltHex>:<hashHex> or sha256:<hex> (or strong plaintext ADMIN_PASSWORD)
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# Optional local MacBook command key (keep empty or strong random secret in prod)
MAC_ADMIN_KEY=

# --- CORS & Origins ---
FRONTEND_URLS=https://conon-now.netlify.app,https://cononinfrabuilt.com
ALLOWED_ORIGINS=https://conon-now.netlify.app,https://cononinfrabuilt.com

# --- Payments & Integrations ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FAST2SMS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Frontend Build Variables (Netlify / Vercel — PUBLIC ONLY, NO SECRETS) ---
VITE_API_URL=https://conon-api-prod.up.railway.app
VITE_LOCAL_ADMIN=false
VITE_GOOGLE_MAPS_API_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
